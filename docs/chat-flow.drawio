eb hits" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1226" width="270" height="72" as="geometry"/></mxCell><mxCell id="c73" value="Tavily task discovery, up to 3 queries; OpenRouter suggest (1 call)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1226" width="330" height="72" as="geometry"/></mxCell><mxCell id="c74" value="research_results kind chat; request_draft; assistant message with suggestions" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1226" width="300" height="72" as="geometry"/></mxCell><mxCell id="c75" value="suggestions {cards}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1226" width="220" height="72" as="geometry"/></mxCell><mxCell id="c76" value="discover_answer" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1302" width="150" height="56" as="geometry"/></mxCell><mxCell id="c77" value="General destination question" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1302" width="270" height="56" as="geometry"/></mxCell><mxCell id="c78" value="OpenRouter discover (1 call)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1