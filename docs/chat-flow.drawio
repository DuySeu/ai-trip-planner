220" height="56" as="geometry"/></mxCell><mxCell id="c55" value="web_lookup&lt;br&gt;(advice)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1150" width="150" height="72" as="geometry"/></mxCell><mxCell id="c56" value="Search the web, answer from the hits" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1150" width="270" height="72" as="geometry"/></mxCell><mxCell id="c57" value='Tavily task chat: the query, then "&amp;lt;query&amp;gt; travel guide" if empty; OpenRouter answer' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1150" width="330" height="72" as="geometry"/></mxCell><mxCell id="c58" value="research_results kind chat (trip or conversation); assistant message {searched: true}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1150" width="300" height="72" as="geometry"/></mxCell><mxCell id="c59" value="token*" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1150" width="220" height="72" as="geometry"/></mxCell><mxCell id="c60" value="discover&lt;br&gt;(discover)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1226" width="150" height="104" as="geometry"/></mxCell><mxCell id="c61" value="Read the message into the draft. Draft misses an answer -&amp;gt; questionnaire card at the first missing step. Draft full, or a card already open (typed instead of pressed) -&amp;gt; close it and suggest" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1226" width="270" height="104" as="geometry"/></mxCell><mxCell id="c62" value="OpenRouter discover (extract, 1 call); to suggest: Tavily task discovery, up to 3 queries + OpenRouter suggest (1 call, repair once)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1226" width="330" height="104" as="geometry"/></mxCell><mxCell id="c63" value="request_draft; card {kind questionnaire, status open}, or research_results kind chat + message {kind suggestions, cards}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1226" width="300" height="104" as="geometry"/></mxCell><mxCell id="c64" value="metadata (card, with message_id), or token* + metadata (suggestions)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1226" width="220" height="104" as="geometry"/></mxCell><mxCell id="c65" value="hotel_search&lt;br&gt;(booking_search)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1334" width="150" height="88" as="geometry"/></mxCell><mxCell id="c66" value="Dates from the open trip or the draft that keep the rules -&amp;gt; search; else a card asking for dates" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillCo