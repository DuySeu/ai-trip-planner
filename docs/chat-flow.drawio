fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1502" width="300" height="72" as="geometry"/></mxCell><mxCell id="c79" value="metadata (form, with message_id), no tokens" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1502" width="220" height="72" as="geometry"/></mxCell><mxCell id="c80" value="edit_plan&lt;br&gt;(edit_plan)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1578" width="150" height="72" as="geometry"/></mxCell><mxCell id="c81" value="Edit the plan; a change of dates, travelers, origin or language queues a re-plan job" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1578" width="270" height="72" as="geometry"/></mxCell><mxCell id="c82" value="OpenRouter edit (1 call, repair once)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1578" width="330" height="72" as="geometry"/></mxCell><mxCell id="c83" value="save_plan (plan_revision + 1) or jobs.enqueue with the new request; conflict event if a job is active" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1578" width="300" height="72" as="geometry"/></mxCell><mxCell id="c84" value="plan {plan_revision}, token*" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1578" width="220" height="72" as="geometry"/></mxCell><mxCell id="c85" value="card: discover_message_id&lt;br&gt;(discover)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1654" width="150" height="72" as="geometry"/></mxCell><mxCell id="c86" value="Suggest now on the questionnaire card, from the draft as it is" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1654" width="270" height="72" as="geometry"/></mxCell><mxCell id="c87" value="as discover, suggest part" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1654" width="330" height="72" as="geometry"/></mxCell><mxCell id="c88" value="research_results kind chat; message {kind suggestions, cards}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1654" width="300" height="72" as="geometry"/></mxCell><mxCell id="c89" value="token* + metadata" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1654" width="220" height="72" as="geometry"/></mxCell><mxCell id="c90" value="card: booking_message_id&lt;br&gt;(booking_search)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#7a8399;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1730" width="150" height="72" as="geometry"/></mxCell><mxCell id="c91" value="Search on the dates card with the chosen dates" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="195" y="1730" width="270" height="72" as="geometry"/></mxCell><mxCell id="c92" value="as hotel_search / flight_search" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="475" y="1730" width="330" height="72" as="geometry"/></mxCell><mxCell id="c93" value="request_draft dates, origin when empty; research_results; message {status results}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="815" y="1730" width="300" height="72" as="geometry"/></mxCell><mxCell id="c94" value="token* + metadata" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="1125" y="1730" width="220" height="72" as="geometry"/></mxCell><mxCell id="c95" value="Every turn streams its text as token events, one per word. The assistant message is saved with the text sent so far when the stream ends, fails or the client leaves; cards and forms are saved before their event, so the event carries their message_id." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1810" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c96" value="3. Read the SSE stream&lt;br&gt;token -&amp;gt; append text&lt;br&gt;plan -&amp;gt; reload the trip&lt;br&gt;metadata -&amp;gt; show the form,&lt;br&gt;questionnaire, dates card&lt;br&gt;or cards&lt;br&gt;error -&amp;gt; show message&lt;br&gt;done -&amp;gt; reload the thread" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="1866" width="190" height="140" as="geometry"/></mxCell><mxCell id="c97" value="events yielded by the turn&lt;br&gt;token* , plan | metadata ,&lt;br&gt;(error) , done&lt;br&gt;REPLY_ERRORS become an error&lt;br&gt;event; the HTTP status stays 200" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="575" y="1886" width="300" height="100" as="geometry"/></mxCell><mxCell id="c98" value="SSE (C)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d3142;fontColor=#2d3142;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c97" target="c96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c99" value="messages (assistant)&lt;br&gt;role, content, intent,&lt;br&gt;metadata jsonb (E)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e4e9f5;strokeColor=#4f5d75;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="925" y="1886" width="220" height="100" as="geometry"/></mxCell><mxCell id="c100" value="finally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d3142;fontColor=#2d3142;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c97" target="c99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c101" value="4. PATCH /conversations/&lt;br&gt;{id}/messages/{message_id}&lt;br&gt;body = F" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="35" y="2046" width="190" height="70" as="geometry"/></mxCell><mxCell id="c102" value="update_message&lt;br&gt;answer: answer_questionnaire, locks the&lt;br&gt;card, saves step, answers, choices and&lt;br&gt;the draft; no AI call&lt;br&gt;cancel: form status open -&amp;gt; canceled" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2d3142;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="265" y="2036" width="270" height="100" as="geometry"/></mxCell><mxCell id="c103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d3142;fontColor=#2d3142;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c101" target="c102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c104" value="200 MessageOut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d3142;fontColor=#2d3142;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;dashed=1;" edge="1" parent="1" source="c102" target="c101"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c105" value="messages.metadata&lt;br&gt;conversations.request_draft" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e4e9f5;strokeColor=#4f5d75;fontFamily=Helvetica;fontSize=11;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="925" y="2046" width="220" height="80" as="geometry"/></mxCell><mxCell id="c106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d3142;fontColor=#2d3142;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c102" target="c105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c107" value="404 other conversation&lt;br&gt;409 card or form closed&lt;br&gt;422 