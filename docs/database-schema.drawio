strokeColor=#4f5d75;strokeWidth=1.2;fontSize=9;fontColor=#4f5d75;fontFamily=Courier New;labelBackgroundColor=#f5f5f5;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.773;entryDx=0;entryDy=0;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="llm_calls.conversation_id" target="conversations.id"><mxGeometry x="0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="125.0"/><mxPoint x="400" y="327.0"/></Array></mxGeometry></mxCell><mxCell id="fk10" value="SET NULL" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=8;strokeColor=#4f5d75;strokeWidth=1.2;fontSize=9;fontColor=#4f5d75;fontFamily=Courier New;labelBackgroundColor=#f5f5f5;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.500;entryDx=0;entryDy=0;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="llm_calls.message_id" target="messages.id"><mxGeometry x="0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="147.0"/><mxPoint x="390" y="81.0"/></Array></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Rules the database enforces&lt;/b&gt;&lt;br&gt;trips: end_date &amp;gt;= start_date; at most 30 days; local_currency is null exactly when destination_country = 'VN'; plan, total_cost_vnd, over_budget all set or all null&lt;br&gt;users: name_key = lower(btrim(name)) unique (needs the builtin C.UTF-8 locale)&lt;br&gt;research_results: exactly one of trip_id, conversation_id&lt;br&gt;jobs: one queued or running job per trip (partial unique index)&lt;br&gt;messages: user content 1 to 4000 chars&lt;br&gt;Enum-like columns are text + CHECK (values in sql/migrations/0001_init.sql)&lt;br&gt;&lt;br&gt;&lt;b&gt;Lines&lt;/b&gt;: solid = NOT NULL FK, dashed = nullable FK; label at the parent end = ON DELETE action" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=11;fontColor=#2d3142;fillColor=#f5f5f5;strokeColor=#bfc0c0;rounded=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="320" height="300" as="geometry"/></mxCell><mxCell id="title" value="AI trip planner: database schema (sql/migrations/0001_init.sql)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#2d3142;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
