# Copy to .env and fill in. Never commit .env.

# Postgres connection for the API, worker, migrations and docker compose.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# LLM provider for the whole app: openrouter (default), openai or bedrock
LLM_PROVIDER=
# Key of the chosen provider: OPENROUTER_API_KEY for openrouter, OPENAI_API_KEY for openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Bedrock (Claude models only): keys may stay empty to use the default AWS credential chain;
# with AWS_ROLE_ARN the app assumes that role. AWS_REGION defaults to ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_ARN=
AWS_REGION=
TAVILY_API_KEY=

# Ordered fallback lists of model ids of the chosen provider (comma-separated). For openrouter
# only ids in src/core/constants.py are used; for openai and bedrock the ids are sent as written
PLANNER_MODELS=
CHAT_MODELS=
CLASSIFIER_MODELS=
# Optional embedding model ids of the chosen provider, for an embedding guard of the guardrail
# (openrouter: the OPENROUTER-EMBED ids in src/core/constants.py)
EMBEDDING_MODELS=

# Daily ceilings, set from your real account quota. Chat ceiling must be greater than the new-trips one.
DAILY_LLM_CEILING_NEW_TRIPS=
DAILY_LLM_CEILING_CHAT=
DAILY_TAVILY_CEILING=

# Optional, defaults shown in src/core/settings.py
# Max LLM calls per plan job, retries included
LLM_CALLS_PER_JOB=
# Per-call LLM timeouts in seconds (Bedrock uses PLANNER_TIMEOUT_S for every call)
PLANNER_TIMEOUT_S=
CHAT_TIMEOUT_S=
# Output token limit, sent only to Bedrock, which requires one
MAX_OUTPUT_TOKENS=
# Hour (UTC) when the free OpenRouter quota resets (unverified, default 0)
QUOTA_RESET_HOUR_UTC=
# Regex matched against provider errors to detect the daily or monthly cap (unverified wording)
OPENROUTER_DAILY_CAP_PATTERN=
TAVILY_QUOTA_PATTERN=
# Days of inactivity before a name with no trips is deleted
USER_INACTIVE_DAYS=
# Trust X-Forwarded-For only behind a known proxy (true/false)
TRUST_PROXY_HEADERS=
# Allowed frontend origins (comma-separated)
CORS_ORIGINS=
# Rate limits
IP_REQUESTS_PER_MINUTE=
IP_CHAT_PER_MINUTE=
IP_TRIPS_PER_DAY=
IP_CHAT_PER_DAY=
USER_TRIPS_PER_DAY=
USER_CHAT_PER_DAY=
# Excel template used for exports
TEMPLATE_PATH=
